:root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #17212b;
    background: #eef3f7;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

.skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 0.5rem;
    color: #17212b;
    background: #fff;
    box-shadow: 0 0 0 3px #176b5b;
    transform: translateY(-200%);
}

.skip-link:focus {
    transform: translateY(0);
}

.page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
}

.app-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
}

.app-content {
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 3.5rem);
}

.sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    overflow-y: auto;
    padding: 1rem 0.625rem;
    color: #fff;
    background: #151515;
}

.sidebar__logo {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.6rem;
    padding: 0 0.5rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
}

.sidebar__logo-mark {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    flex: none;
    place-items: center;
    border-radius: 0.45rem;
    color: #102235;
    background: #7db7eb;
    font-size: 0.75rem;
    font-weight: 650;
}

.sidebar__navigation {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.45rem;
}

.sidebar__account {
    margin-top: auto;
}

.sidebar__category {
    margin: 0 0 0.9rem;
    padding: 0 0.625rem;
    color: #9095a7;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.sidebar__list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.sidebar__list li + li {
    margin-top: 0.25rem;
}

.sidebar__link {
    display: block;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.65rem 0.625rem;
    border: 0;
    border-radius: 0.55rem;
    color: #fff;
    background: transparent;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: left;
    text-decoration: none;
}

a.sidebar__link:hover,
.sidebar__logout-button:hover {
    color: #fff;
    background: #242424;
}

.sidebar__link:focus-visible,
.sidebar__logo:focus-visible {
    outline: 3px solid #7db7eb;
    outline-offset: 2px;
}

.sidebar__link[aria-current="page"] {
    color: #101820;
    background: #7db7eb;
}

.sidebar__link--disabled {
    color: #fff;
}

.sidebar__logout-form {
    margin: 0;
}

.sidebar__logout-button {
    margin: 0;
    cursor: pointer;
}

.auth-card,
.dashboard-card {
    width: min(100%, 30rem);
    padding: 2rem;
    border: 1px solid #d8e0e7;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1.25rem 3rem rgba(23, 33, 43, 0.1);
}

.dashboard-card {
    width: min(100%, 64rem);
}

.content-header {
    width: min(100%, 64rem);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
}

.content-header h1,
.content-header .muted {
    margin-bottom: 0;
}

.action-button,
.secondary-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
}

.action-button {
    color: #fff;
    background: #176b5b;
}

.action-button:hover {
    background: #115448;
}

.secondary-action {
    border-color: #aeb9c3;
    color: #17212b;
    background: #fff;
}

.secondary-action:hover {
    border-color: #7f8d98;
    background: #f5f7f9;
}

.action-button:focus-visible,
.secondary-action:focus-visible,
.text-link:focus-visible {
    outline: 3px solid rgba(23, 107, 91, 0.25);
    outline-offset: 2px;
}

.content-panel {
    width: min(100%, 64rem);
    overflow: hidden;
    border: 1px solid #d8e0e7;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1rem 2.5rem rgba(23, 33, 43, 0.07);
}

.content-panel--form {
    max-width: 42rem;
    padding: 1.75rem;
}

.table-scroll {
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.data-table th,
.data-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e2e8ed;
}

.data-table thead th {
    color: #52616d;
    background: #f5f7f9;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.data-table tbody tr:last-child th,
.data-table tbody tr:last-child td {
    border-bottom: 0;
}

.data-table tbody th {
    font-weight: 650;
}

.data-table__actions {
    width: 1%;
    text-align: right;
    white-space: nowrap;
}

.text-link {
    color: #176b5b;
    font-weight: 700;
    text-underline-offset: 0.18em;
}

.empty-state {
    color: #66727d;
    text-align: center;
}

.article-form,
.form-field:first-child label {
    margin-top: 0;
}

.form-field label {
    margin-bottom: 0.4rem;
}

.field-hint {
    margin: 0.45rem 0 0;
    color: #66727d;
    font-size: 0.85rem;
}

.form-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
}

.form-actions button {
    width: auto;
    margin: 0;
}

h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
}

.eyebrow {
    margin: 0 0 0.5rem;
    color: #176b5b;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.muted {
    margin: 0 0 1.5rem;
    color: #66727d;
    line-height: 1.55;
}

label {
    display: block;
    margin: 1rem 0 0.4rem;
    font-weight: 650;
}

input {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid #aeb9c3;
    border-radius: 0.55rem;
    font: inherit;
}

input:focus {
    border-color: #176b5b;
    outline: 3px solid rgba(23, 107, 91, 0.16);
}

button {
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.85rem 1rem;
    border: 0;
    border-radius: 0.55rem;
    color: #fff;
    background: #176b5b;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
}

button:hover {
    background: #115448;
}

.alert {
    margin: 1rem 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid #e8b7b7;
    border-radius: 0.55rem;
    color: #8b2525;
    background: #fff0f0;
}

@media (max-width: 52rem) {
    .app-shell {
        grid-template-columns: 1fr;
    }

    .sidebar {
        position: static;
        height: auto;
        min-height: auto;
    }

    .sidebar__account {
        margin-top: 0;
    }

    .sidebar__list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.2rem;
    }

    .sidebar__list li + li {
        margin-top: 0;
    }

 
    .content-header {
        flex-direction: column;
        gap: 1rem;
    }

    .content-panel--form {
        padding: 1.25rem;
    }
}
