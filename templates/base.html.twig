<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Warehouse Manager{% endblock %}</title>
    <link rel="stylesheet" href="/styles/app.css">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="{{ app.user ? 'has-sidebar' : 'is-auth-page' }}">
    <a class="skip-link" href="#main-content">Przejdź do treści</a>

    <div class="{{ app.user ? 'app-shell' : 'auth-shell' }}">
        {% if app.user %}
            {% include 'layout/_sidebar.html.twig' %}
        {% endif %}

        <main
            id="main-content"
            class="{{ app.user ? 'app-content' : 'page' }}"
            tabindex="-1"
        >
            {% block body %}{% endblock %}
        </main>
    </div>
</body>
</html>
